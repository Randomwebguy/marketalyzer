//@version=5
// Supertrend yükselişe döndüğünde alır, düşüşe döndüğünde satar.
// ATR tabanlı olduğu için oynak hisselerde bantlar genişler.
strategy("Supertrend", overlay=true)

factor = input.float(3.0, "Çarpan", minval=1.5, maxval=4.5, step=0.5)
atrPeriod = input.int(10, "ATR periyodu", minval=7, maxval=21, step=7)

[st, direction] = ta.supertrend(factor, atrPeriod)
plot(direction < 0 ? st : na, "Yükseliş", color=color.green, style=plot.style_linebr)
plot(direction > 0 ? st : na, "Düşüş", color=color.red, style=plot.style_linebr)

if ta.change(direction) < 0
    strategy.entry("Al", strategy.long)
if ta.change(direction) > 0
    strategy.close("Al")
